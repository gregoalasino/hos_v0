                {usagePct !== null && (
                  <div className="h-1 bg-slate-100 rounded-full mt-1 overflow-hidden">
                    <div className="h-full rounded-full transition-all" style={{ width: `${Math.min(usagePct, 100)}%`, backgroundColor: usagePct >= 90 ? ADMIN_TERRA : ADMIN_SAGE }} />
