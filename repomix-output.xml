              </motion.div>
              <motion.div variants={itemVariants}>
                <div className="aspect-square overflow-hidden rounded-md">
                  <img src={galleryImages[1].src} alt={galleryImages[1].alt} className="w-full h-full object-cover hover:scale-105 transition-transform duration-700" />
                </div>
              </motion.div>
              <motion.div variants={itemVariants}>
                <div className="aspect-square overflow-hidden rounded-md">
                  <img src={galleryImages[2].src} alt={galleryImages[2].alt} className="w-full h-full object-cover hover:scale-105 transition-transform duration-700" />
                </div>
              </motion.div>
            </motion.div>
          </div>
        </div>
      </section>

      {/* Calendario semanal */}
      <section ref={scheduleRef} className="py-24 lg:py-32 bg-warm-white">
        <div className="max-w-7xl mx-auto px-6">
          <motion.div
            initial={{ opacity: 0, y: 40 }}
            animate={scheduleInView ? { opacity: 1, y: 0 } : { opacity: 0, y: 40 }}
            transition={{ duration: 0.8, ease: "easeOut" }}
            className="text-center mb-16"
          >
            <span className="text-sm tracking-[0.3em] uppercase text-burgundy mb-4 block">
              Horario Semanal
            </span>
            <h2 className="font-serif text-4xl md:text-5xl font-light text-dark mb-4">
              Clases de la Semana
            </h2>
            <p className="text-dark/60">
              Semana del{" "}
              <span className="text-dark font-medium">
                {format(weekDays[0], "d 'de' MMMM", { locale: es })}
              </span>
            </p>
          </motion.div>

          <motion.div
            variants={containerVariants}
            initial="hidden"
            animate={scheduleInView ? "visible" : "hidden"}
            className="w-full"
          >
            <div className="lg:hidden text-center text-xs tracking-wider uppercase text-dark/40 mb-6 animate-pulse">
              ← Desliza para ver la semana completa →
            </div>

            <div className="overflow-x-auto pb-8 hide-scrollbar">
              <div className="min-w-[900px] max-w-6xl mx-auto w-full grid grid-cols-[100px_repeat(5,1fr)] gap-3 lg:gap-4">

                {/* Cabecera días */}
                <div className="col-span-1" />
                {weekDays.map((day) => (
                  <div key={day.toISOString()} className="text-center border-b border-dark/10 pb-4">
                    <p className="font-serif text-xl text-dark">
                      {format(day, "EEEE", { locale: es })}
                    </p>
                    <p className="text-xs text-dark/40 mt-0.5">
                      {format(day, "d MMM", { locale: es })}
                    </p>
                  </div>
                ))}

                {/* Filas de horarios */}
                {TIME_SLOTS.map((slot, slotIndex) => (
                  <React.Fragment key={slot}>
                    <div className="flex items-center justify-end pr-4 border-r border-dark/10 mt-4">
                      <span className="text-xs font-medium text-dark/50 flex items-center gap-1.5">
                        <Clock className="w-3.5 h-3.5" />
                        {TIME_LABELS[slotIndex]}
                      </span>
                    </div>

                    {weekDays.map((_, dayIndex) => {
                      const clase = classMap.get(`${dayIndex}-${slotIndex}`);
                      return (
                        <div key={`${dayIndex}-${slotIndex}`} className="mt-4">
                          {clase ? (
                            <ClassCard clase={clase} />
                          ) : (
                            <div className="h-full min-h-[120px] rounded-2xl border border-dashed border-dark/10 flex items-center justify-center">
                              <span className="text-xs text-dark/30 italic">Sin clase</span>
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </React.Fragment>
                ))}
              </div>
            </div>
          </motion.div>
        </div>
      </section>

      {/* Footer CTA */}
      <section className="py-20 bg-dark text-cream text-center">
        <div className="max-w-2xl mx-auto px-6">
          <h3 className="font-serif text-3xl md:text-4xl mb-6">
            ¿Listo para comenzar tu práctica?
          </h3>
          <p className="text-cream/70 mb-8">
            Al reservar una noche puedes agregar clases de yoga con descuento.
          </p>
          <div className="hidden md:flex justify-center items-center cloudbeds-btn-container">
            <cb-book-now-button property-code="zE6Wy8" />
          </div>
        </div>
      </section>
    </motion.main>
  );
}

function ClassCard({ clase }: { clase: YogaClass }) {
  const agotada = clase.spotsRemaining === 0;

  return (
    <motion.div
      variants={itemVariants}
      className="bg-cream rounded-2xl p-4 border border-dark/5 hover:border-dark/10 hover:shadow-lg transition-all duration-300 flex flex-col h-full group min-h-[120px]"
    >
      <h4 className="font-serif text-base text-dark mb-0.5 group-hover:text-burgundy transition-colors leading-tight">
        {clase.name}
      </h4>
      <p className="text-xs text-dark/60 mb-1">con {clase.instructor}</p>
      <p className="text-xs text-dark/40 flex items-center gap-1 mb-auto">
        <MapPin className="w-3 h-3" />
        {clase.location}
      </p>

      <div className="mt-3 flex items-center justify-between border-t border-dark/5 pt-3">
        <div className="flex flex-col gap-0.5">
          <span className="text-xs font-medium text-dark/50 flex items-center gap-1">
            <Users className="w-3 h-3" />
            {clase.spotsRemaining}/{clase.capacity}
          </span>
          <span className="text-xs text-burgundy font-medium">
            {clase.priceUsd === 0 ? "Gratis" : `$${clase.priceUsd}`}
          </span>
        </div>

        {agotada ? (
          <span className="bg-dark/10 text-dark/40 px-3 py-1.5 rounded-full text-xs">
            Agotado
          </span>
        ) : (
          <Link
            href={`/booking/${clase.id}`}
            className="bg-dark text-cream px-3 py-1.5 rounded-full text-xs tracking-wide hover:bg-burgundy transition-colors shadow-sm"
          >
            Reservar
          </Link>
        )}
      </div>
    </motion.div>
  );
}
