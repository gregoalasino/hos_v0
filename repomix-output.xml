                    backgroundColor: code.benefitType === 'percentage' ? '#4a7c5918' : code.benefitType === 'fixed' ? '#2563eb18' : '#c4622d18',
                    color: code.benefitType === 'percentage' ? ADMIN_SAGE : code.benefitType === 'fixed' ? '#2563eb' : ADMIN_TERRA,
                  }}
