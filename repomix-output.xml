'use client';

import { useState, useMemo } from 'react';
import { format, startOfWeek, addDays, isSameDay } from 'date-fns';
import { es } from 'date-fns/locale';
import { ChevronLeft, ChevronRight, Plus, Users, Clock } from 'lucide-react';
import { MOCK_CLASSES, MOCK_BOOKINGS } from '@/lib/mock-data';
import type { YogaClass } from '@/types';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Sheet, SheetContent, SheetHeader, SheetTitle } from '@/components/ui/sheet';

// Grilla: 6:00 AM a 11:00 AM = 5 horas
const GRID_START_HOUR = 6;
const GRID_END_HOUR = 11;
const TOTAL_MINUTES = (GRID_END_HOUR - GRID_START_HOUR) * 60;
const HOUR_PX = 80; // px por hora
const GRID_HEIGHT = (GRID_END_HOUR - GRID_START_HOUR) * HOUR_PX;

const timeLabels = Array.from(
  { length: GRID_END_HOUR - GRID_START_HOUR + 1 },
  (_, i) => `${String(GRID_START_HOUR + i).padStart(2, '0')}:00`
);

function classTopPx(startsAt: Date): number {
  const minutes = startsAt.getHours() * 60 + startsAt.getMinutes() - GRID_START_HOUR * 60;
  return Math.max(0, (minutes / 60) * HOUR_PX);
}

function classHeightPx(durationMinutes: number): number {
  return (durationMinutes / 60) * HOUR_PX;
}

const STATUS_BADGE = {
  paid: { label: 'Pagado', cls: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
  free: { label: 'Gratis', cls: 'bg-blue-50 text-blue-700 border-blue-200' },
  pending: { label: 'Pendiente', cls: 'bg-yellow-50 text-yellow-700 border-yellow-200' },
  cancelled: { label: 'Cancelado', cls: 'bg-gray-100 text-gray-500 border-gray-200' },
  'no-show': { label: 'No-show', cls: 'bg-red-50 text-red-600 border-red-200' },
};

export default function CalendarioPage() {
  const [weekOffset, setWeekOffset] = useState(0);
  const [selectedClass, setSelectedClass] = useState<YogaClass | null>(null);
  const [drawerOpen, setDrawerOpen] = useState(false);

  const weekDays = useMemo(() => {
    const today = new Date();
    const reference = today.getDay() === 0 ? addDays(today, 1) : today;
    const monday = addDays(startOfWeek(reference, { weekStartsOn: 1 }), weekOffset * 7);
    return Array.from({ length: 7 }, (_, i) => addDays(monday, i));
  }, [weekOffset]);

  const weekLabel = useMemo(() => {
    const start = weekDays[0];
    const end = weekDays[6];
    if (start.getMonth() === end.getMonth()) {
      return `${format(start, 'd')} – ${format(end, 'd')} de ${format(start, 'MMMM yyyy', { locale: es })}`;
    }
    return `${format(start, 'd MMM', { locale: es })} – ${format(end, 'd MMM yyyy', { locale: es })}`;
  }, [weekDays]);

  const classMap = useMemo(() => {
    const map = new Map<number, YogaClass[]>();
    weekDays.forEach((_, dayIdx) => map.set(dayIdx, []));
    MOCK_CLASSES.filter((c) => c.isActive).forEach((c) => {
      const dayIdx = weekDays.findIndex((d) => isSameDay(d, c.startsAt));
      if (dayIdx !== -1) {
        map.get(dayIdx)!.push(c);
      }
    });
    return map;
  }, [weekDays]);

  function openClass(clase: YogaClass) {
    setSelectedClass(clase);
    setDrawerOpen(true);
  }

  const classBookings = useMemo(
    () => selectedClass
      ? MOCK_BOOKINGS.filter((b) => b.classId === selectedClass.id)
      : [],
    [selectedClass]
  );

  return (
    <div className="flex flex-col h-full">
      {/* Toolbar */}
      <div className="flex items-center justify-between px-5 py-4 bg-white border-b border-gray-100">
        <div className="flex items-center gap-3">
          <div className="flex items-center">
            <button
              onClick={() => setWeekOffset((o) => o - 1)}
              className="p-1.5 rounded-md hover:bg-gray-100 text-slate-500 transition-colors"
            >
              <ChevronLeft className="w-4 h-4" />
            </button>
            <button
              onClick={() => setWeekOffset(0)}
              className="px-3 py-1.5 text-xs font-medium rounded-md hover:bg-gray-100 text-slate-600 transition-colors"
            >
              Hoy
            </button>
            <button
              onClick={() => setWeekOffset((o) => o + 1)}
              className="p-1.5 rounded-md hover:bg-gray-100 text-slate-500 transition-colors"
            >
              <ChevronRight className="w-4 h-4" />
            </button>
          </div>
          <h2 className="text-sm font-semibold text-slate-800 capitalize">{weekLabel}</h2>
        </div>

        <Button
          size="sm"
          className="gap-1.5 text-xs text-white"
          style={{ backgroundColor: '#c4622d' }}
        >
          <Plus className="w-3.5 h-3.5" />
          Generar semana
        </Button>
      </div>

      {/* Calendario */}
      <div className="flex-1 overflow-auto">
        <div className="flex min-w-[700px]">
          {/* Columna de horas */}
          <div className="w-14 flex-shrink-0 border-r border-gray-100 pt-10">
            {timeLabels.map((t) => (
              <div
                key={t}
                className="flex items-start justify-end pr-2 text-[10px] text-slate-400"
                style={{ height: HOUR_PX }}
              >
                <span className="-mt-2">{t}</span>
              </div>
            ))}
          </div>

          {/* Columnas de días */}
          <div className="flex flex-1 divide-x divide-gray-100">
            {weekDays.map((day, dayIdx) => {
              const isToday = isSameDay(day, new Date());
              return (
                <div key={day.toISOString()} className="flex-1 min-w-0">
                  {/* Encabezado del día */}
                  <div className={`text-center py-2 border-b border-gray-100 ${isToday ? 'bg-slate-50' : 'bg-white'}`}>
                    <p className="text-[10px] uppercase tracking-wide text-slate-400">
                      {format(day, 'EEE', { locale: es })}
                    </p>
                    <p className={`text-sm font-semibold mt-0.5 ${isToday ? 'text-white rounded-full w-6 h-6 flex items-center justify-center mx-auto' : 'text-slate-700'}`}
                      style={isToday ? { backgroundColor: '#4a7c59' } : undefined}
                    >
                      {format(day, 'd')}
                    </p>
                  </div>

                  {/* Grid de tiempo */}
                  <div
                    className="relative"
                    style={{ height: GRID_HEIGHT }}
                  >
                    {/* Líneas de hora */}
                    {Array.from({ length: GRID_END_HOUR - GRID_START_HOUR }, (_, i) => (
                      <div
                        key={i}
                        className="absolute left-0 right-0 border-b border-gray-100"
                        style={{ top: (i + 1) * HOUR_PX }}
                      />
                    ))}

                    {/* Clases del día */}
                    {(classMap.get(dayIdx) ?? []).map((clase) => (
                      <ClassBlock
                        key={clase.id}
                        clase={clase}
                        onClick={() => openClass(clase)}
                      />
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      {/* Drawer de detalle */}
      <Sheet open={drawerOpen} onOpenChange={setDrawerOpen}>
        <SheetContent side="right" className="w-full sm:w-[420px] overflow-y-auto">
          {selectedClass && (
            <>
              <SheetHeader className="mb-5">
                <div className="flex items-center gap-2 mb-1">
                  <span
                    className="w-3 h-3 rounded-full flex-shrink-0"
                    style={{ background: selectedClass.color }}
                  />
                  <SheetTitle className="text-lg font-semibold text-slate-900">
                    {selectedClass.name}
                  </SheetTitle>
                </div>
              </SheetHeader>

              {/* Detalles de la clase */}
              <div className="space-y-3 mb-6">
                <DetailRow label="Instructor" value={selectedClass.instructor} />
                <DetailRow
                  label="Fecha y hora"
                  value={format(selectedClass.startsAt, "EEEE d 'de' MMMM · HH:mm", { locale: es })}
                />
                <DetailRow label="Duración" value={`${selectedClass.durationMinutes} minutos`} />
                <DetailRow label="Ubicación" value={selectedClass.location} />
                <DetailRow
                  label="Precio"
                  value={selectedClass.priceUsd === 0 ? 'Gratis' : `$${selectedClass.priceUsd} USD`}
                />
                <DetailRow
                  label="Capacidad"
                  value={`${selectedClass.capacity - selectedClass.spotsRemaining}/${selectedClass.capacity} reservas`}
                />
              </div>

              {/* Acciones */}
              <div className="flex gap-2 mb-6">
                <Button variant="outline" size="sm" className="flex-1 text-xs">
                  Editar
                </Button>
                <Button
                  size="sm"
                  className="flex-1 text-xs text-white"
                  style={{ backgroundColor: '#4a7c59' }}
                >
                  + Reserva manual
                </Button>
                <Button variant="outline" size="sm" className="text-xs text-red-600 border-red-200 hover:bg-red-50">
                  Cancelar
                </Button>
              </div>

              {/* Lista de reservas */}
              <div>
                <h3 className="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">
                  Reservas ({classBookings.length})
                </h3>
                {classBookings.length === 0 ? (
                  <p className="text-sm text-slate-400 py-4 text-center">Sin reservas todavía</p>
                ) : (
                  <ul className="space-y-2">
                    {classBookings.map((b) => {
                      const status = STATUS_BADGE[b.paymentStatus] ?? STATUS_BADGE.pending;
                      return (
                        <li key={b.id} className="flex items-center justify-between py-2.5 px-3 rounded-lg bg-gray-50">
                          <div>
                            <p className="text-sm font-medium text-slate-800">
                              {b.firstName} {b.lastName}
                            </p>
                            <p className="text-xs text-slate-400">{b.email}</p>
                          </div>
                          <div className="text-right">
                            <Badge variant="outline" className={`text-[10px] ${status.cls}`}>
                              {status.label}
                            </Badge>
                            {b.persons > 1 && (
                              <p className="text-[10px] text-slate-400 mt-1 flex items-center justify-end gap-1">
                                <Users className="w-2.5 h-2.5" /> {b.persons} pers.
                              </p>
                            )}
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                )}
              </div>
            </>
          )}
        </SheetContent>
      </Sheet>
    </div>
  );
}

function ClassBlock({ clase, onClick }: { clase: YogaClass; onClick: () => void }) {
  const top = classTopPx(clase.startsAt);
  const height = classHeightPx(clase.durationMinutes);
  const filled = clase.capacity - clase.spotsRemaining;

  return (
    <button
      onClick={onClick}
      className="absolute left-0.5 right-0.5 rounded-md px-1.5 py-1 text-left overflow-hidden hover:brightness-95 transition-all shadow-sm"
      style={{
        top,
        height: Math.max(height, 36),
        backgroundColor: clase.color + 'dd',
      }}
    >
      <p className="text-[10px] font-semibold text-white leading-tight truncate">{clase.name}</p>
      <p className="text-[9px] text-white/80 truncate">{format(clase.startsAt, 'HH:mm')}</p>
      {height >= 52 && (
        <p className="text-[9px] text-white/70 mt-0.5">{filled}/{clase.capacity}</p>
      )}
    </button>
  );
}

function DetailRow({ label, value }: { label: string; value: string }) {
  return (
    <div className="flex items-start justify-between gap-4 py-1.5 border-b border-gray-50 last:border-0">
      <span className="text-xs text-slate-400 flex-shrink-0">{label}</span>
      <span className="text-xs text-slate-800 text-right">{value}</span>
    </div>
  );
}
