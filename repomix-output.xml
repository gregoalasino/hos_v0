<file path="app/booking/[classId]/BookingFlow.tsx">
'use client';

import { useState, useMemo } from 'react';
import Link from 'next/link';
import { format } from 'date-fns';
import { es } from 'date-fns/locale';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';
import { motion, AnimatePresence } from 'framer-motion';
import {
  ArrowLeft, ArrowRight, Clock, MapPin, Users, Check,
  CreditCard, Minus, Plus, Calendar, ChevronDown,
} from 'lucide-react';
import { MOCK_UPSELLS } from '@/lib/mock-data';
import { downloadICS } from '@/lib/ics';
import BookingStep from '@/components/booking/BookingStep';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Checkbox } from '@/components/ui/checkbox';
import {
  Form, FormControl, FormField, FormItem, FormLabel, FormMessage,
} from '@/components/ui/form';

type Props = {
  classId: string;
  className: string;
  instructor: string;
  startsAt: string;
  durationMinutes: number;
  capacity: number;
  spotsRemaining: number;
  priceUsd: number;
  location: string;
  description: string;
  color?: string;
};

const personalSchema = z.object({
  firstName: z.string().min(1, 'El nombre es requerido'),
  lastName: z.string().min(1, 'El apellido es requerido'),
  email: z.string().email('Email inválido'),
  phone: z.string().optional(),
  isHotelGuest: z.boolean(),
  cloudbedsRef: z.string().optional(),
});

type PersonalData = z.infer<typeof personalSchema>;

const stepVariants = {
  enter: { opacity: 0, x: 24 },
  center: { opacity: 1, x: 0 },
  exit: { opacity: 0, x: -24 },
};

function generateRef(): string {
  const date = format(new Date(), 'yyyyMMdd');
  const random = Math.random().toString(36).substring(2, 6).toUpperCase();
  return `HOS-${date}-${random}`;
}

export default function BookingFlow({
  classId, className, instructor, startsAt,
  durationMinutes, capacity, spotsRemaining,
  priceUsd, location, description, color,
}: Props) {
  const [step, setStep] = useState(1);
  const [persons, setPersons] = useState(1);
  const [upsellQty, setUpsellQty] = useState<Record<string, number>>({});
  const [personalData, setPersonalData] = useState<PersonalData | null>(null);
  const [bookingRef, setBookingRef] = useState('');

  const classDate = new Date(startsAt);
  const isFree = priceUsd === 0;
  const activeUpsells = MOCK_UPSELLS.filter((u) => u.isActive);

  const subtotalClass = priceUsd * persons;
  const subtotalUpsells = useMemo(
    () => Object.entries(upsellQty).reduce((acc, [id, qty]) => {
      const u = MOCK_UPSELLS.find((u) => u.id === id);
      return acc + (u?.priceUsd ?? 0) * qty;
    }, 0),
    [upsellQty]
  );
  const total = subtotalClass + subtotalUpsells;
  const isTotalFree = total === 0;

  const selectedUpsellsList = useMemo(
    () => Object.entries(upsellQty)
      .filter(([, qty]) => qty > 0)
      .map(([id, qty]) => ({ upsell: MOCK_UPSELLS.find((u) => u.id === id)!, qty }))
      .filter((x) => x.upsell),
    [upsellQty]
  );

  function adjustUpsell(id: string, delta: number) {
    setUpsellQty((prev) => {
      const next = Math.max(0, (prev[id] ?? 0) + delta);
      return { ...prev, [id]: next };
    });
  }

  function adjustPersons(delta: number) {
    setPersons((prev) => Math.min(spotsRemaining, Math.max(1, prev + delta)));
  }

  const form = useForm<PersonalData>({
    resolver: zodResolver(personalSchema),
    defaultValues: {
      firstName: '', lastName: '', email: '',
      phone: '', isHotelGuest: false, cloudbedsRef: '',
    },
  });

  const watchGuest = form.watch('isHotelGuest');

  function handlePersonalSubmit(values: PersonalData) {
    setPersonalData(values);
    setStep(3);
  }

  function handleConfirm() {
    // STRIPE: aquí irá la redirección a Stripe para clases pagas
    const ref = generateRef();
    setBookingRef(ref);
    setStep(4);
  }

  function handleDownloadICS() {
    downloadICS({
      uid: bookingRef,
      title: className,
      description: `Clase de yoga con ${instructor} en House of Shakti. Referencia: ${bookingRef}`,
      location: `${location}, House of Shakti, Costa Rica`,
      startsAt: classDate,
      durationMinutes,
      organizerName: 'House of Shakti',
    }, `HOS-${className.toLowerCase().replace(/\s+/g, '-')}`);
  }

  return (
    <div className="min-h-screen bg-warm-white">
      {/* Header */}
      <header className="bg-dark text-cream px-4 py-4">
        <div className="max-w-2xl mx-auto flex items-center justify-between">
          <Link href="/clases" className="flex items-center gap-2 text-cream/60 hover:text-cream transition-colors text-sm">
            <ArrowLeft className="w-4 h-4" />
            Clases
          </Link>
          <span className="font-serif text-base font-light">House of Shakti</span>
          <div className="w-16" />
        </div>
      </header>

      <div className="max-w-2xl mx-auto px-4 py-8">
        {step < 4 && (
          <div className="mb-8">
            <BookingStep current={step} />
          </div>
        )}

        <AnimatePresence mode="wait">
          {/* ── PASO 1: Detalle + upsells + personas ── */}
          {step === 1 && (
            <motion.div key="step1" variants={stepVariants} initial="enter" animate="center" exit="exit" transition={{ duration: 0.25 }}>
              {/* Hero de clase */}
              <div
                className="relative h-44 rounded-2xl overflow-hidden mb-5"
                style={{ background: color ? `${color}22` : '#F2EBDA' }}
              >
                <img
                  src="/images/yoga-hero.jpeg"
                  alt={className}
                  className="w-full h-full object-cover opacity-70"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-dark/60 to-transparent" />
                <div className="absolute bottom-4 left-4">
                  <div className="flex items-center gap-2 mb-1">
                    {color && <span className="w-2 h-2 rounded-full" style={{ background: color }} />}
                    <span className="text-xs text-cream/80 uppercase tracking-widest">{instructor}</span>
                  </div>
                  <h2 className="font-serif text-2xl text-cream font-light">{className}</h2>
                </div>
              </div>

              {/* Info del slot */}
              <div className="bg-cream rounded-2xl p-4 mb-5 space-y-2">
                <div className="flex items-center gap-2 text-sm text-dark/70">
                  <Clock className="w-4 h-4 text-burgundy flex-shrink-0" />
                  <span>
                    {format(classDate, "EEEE d 'de' MMMM", { locale: es })} ·{' '}
                    {format(classDate, 'HH:mm')} ({durationMinutes} min)
                  </span>
                </div>
                <div className="flex items-center gap-2 text-sm text-dark/70">
                  <MapPin className="w-4 h-4 text-burgundy flex-shrink-0" />
                  {location}
                </div>
                <div className="flex items-center gap-2 text-sm text-dark/70">
                  <Users className="w-4 h-4 text-burgundy flex-shrink-0" />
                  {spotsRemaining} de {capacity} lugares disponibles
                </div>
              </div>

              {description && (
                <p className="text-dark/60 text-sm leading-relaxed mb-5">{description}</p>
              )}

              {/* Selector de personas */}
              <div className="bg-cream rounded-2xl p-4 mb-5">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-sm font-medium text-dark">Cantidad de personas</p>
                    <p className="text-xs text-dark/50 mt-0.5">Máximo {spotsRemaining} lugares</p>
                  </div>
                  <div className="flex items-center gap-3">
                    <button
                      onClick={() => adjustPersons(-1)}
                      disabled={persons <= 1}
                      className="w-8 h-8 rounded-full border border-dark/20 flex items-center justify-center disabled:opacity-30 hover:bg-dark/5 transition-colors"
                    >
                      <Minus className="w-3.5 h-3.5" />
                    </button>
                    <span className="text-lg font-semibold text-dark w-6 text-center">{persons}</span>
                    <button
                      onClick={() => adjustPersons(1)}
                      disabled={persons >= spotsRemaining}
                      className="w-8 h-8 rounded-full border border-dark/20 flex items-center justify-center disabled:opacity-30 hover:bg-dark/5 transition-colors"
                    >
                      <Plus className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              </div>

              {/* Upsells */}
              {activeUpsells.length > 0 && (
                <div className="mb-5">
                  <h3 className="text-sm font-medium text-dark mb-3">Agregar extras</h3>
                  <div className="space-y-2">
                    {activeUpsells.map((u) => {
                      const qty = upsellQty[u.id] ?? 0;
                      return (
                        <div key={u.id} className="bg-cream rounded-xl p-3.5 flex items-center justify-between gap-3">
                          <div className="flex-1 min-w-0">
                            <p className="text-sm font-medium text-dark truncate">{u.name}</p>
                            <p className="text-xs text-dark/50 mt-0.5 leading-relaxed line-clamp-2">{u.description}</p>
                          </div>
                          <div className="flex items-center gap-2.5 flex-shrink-0">
                            <span className="text-sm font-semibold text-dark">${u.priceUsd}</span>
                            {qty === 0 ? (
                              <button
                                onClick={() => adjustUpsell(u.id, 1)}
                                className="flex items-center gap-1 text-xs text-cream bg-dark hover:bg-burgundy px-2.5 py-1.5 rounded-full transition-colors"
                              >
                                <Plus className="w-3 h-3" /> Agregar
                              </button>
                            ) : (
                              <div className="flex items-center gap-2">
                                <button
                                  onClick={() => adjustUpsell(u.id, -1)}
                                  className="w-6 h-6 rounded-full border border-dark/20 flex items-center justify-center hover:bg-dark/5"
                                >
                                  <Minus className="w-3 h-3" />
                                </button>
                                <span className="text-sm font-medium text-dark w-4 text-center">{qty}</span>
                                <button
                                  onClick={() => adjustUpsell(u.id, 1)}
                                  className="w-6 h-6 rounded-full border border-dark/20 flex items-center justify-center hover:bg-dark/5"
                                >
                                  <Plus className="w-3 h-3" />
                                </button>
                              </div>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}

              {/* Resumen de precio */}
              <div className="border border-dark/10 rounded-2xl p-4 mb-6 space-y-2">
                <div className="flex justify-between text-sm text-dark/70">
                  <span>Clase × {persons} persona{persons > 1 ? 's' : ''}</span>
                  <span>{isFree ? 'Gratis' : `$${subtotalClass}`}</span>
                </div>
                {selectedUpsellsList.map(({ upsell, qty }) => (
                  <div key={upsell.id} className="flex justify-between text-sm text-dark/70">
                    <span>{upsell.name} × {qty}</span>
                    <span>${upsell.priceUsd * qty}</span>
                  </div>
                ))}
                <div className="flex justify-between font-semibold text-dark pt-2 border-t border-dark/10">
                  <span>Total</span>
                  <span className={isTotalFree ? 'text-emerald-600' : ''}>
                    {isTotalFree ? 'Gratis' : `$${total} USD`}
                  </span>
                </div>
              </div>

              <Button
                onClick={() => setStep(2)}
                className="w-full bg-dark hover:bg-burgundy text-cream h-12 text-base"
                disabled={spotsRemaining === 0}
              >
                Continuar <ArrowRight className="w-4 h-4 ml-2" />
              </Button>
            </motion.div>
          )}

          {/* ── PASO 2: Datos del alumno ── */}
          {step === 2 && (
            <motion.div key="step2" variants={stepVariants} initial="enter" animate="center" exit="exit" transition={{ duration: 0.25 }}>
              <h2 className="font-serif text-2xl font-light text-dark mb-1">Tus datos</h2>
              <p className="text-sm text-dark/50 mb-6">Usaremos esta información para confirmar tu reserva</p>

              <Form {...form}>
                <form onSubmit={form.handleSubmit(handlePersonalSubmit)} className="space-y-4">
                  <div className="grid grid-cols-2 gap-3">
                    <FormField control={form.control} name="firstName" render={({ field }) => (
                      <FormItem>
                        <FormLabel>Nombre</FormLabel>
                        <FormControl><Input placeholder="Ana" {...field} /></FormControl>
                        <FormMessage />
                      </FormItem>
                    )} />
                    <FormField control={form.control} name="lastName" render={({ field }) => (
                      <FormItem>
                        <FormLabel>Apellido</FormLabel>
                        <FormControl><Input placeholder="García" {...field} /></FormControl>
                        <FormMessage />
                      </FormItem>
                    )} />
                  </div>

                  <FormField control={form.control} name="email" render={({ field }) => (
                    <FormItem>
                      <FormLabel>Email</FormLabel>
                      <FormControl><Input type="email" placeholder="ana@email.com" {...field} /></FormControl>
                      <FormMessage />
                    </FormItem>
                  )} />

                  <FormField control={form.control} name="phone" render={({ field }) => (
                    <FormItem>
                      <FormLabel>
                        Teléfono <span className="text-dark/40 font-normal">(opcional)</span>
                      </FormLabel>
                      <FormControl><Input placeholder="+1 555-0100" {...field} /></FormControl>
                      <FormMessage />
                    </FormItem>
                  )} />

                  {/* Huésped del hotel */}
                  <FormField control={form.control} name="isHotelGuest" render={({ field }) => (
                    <FormItem>
                      <div className="flex items-start gap-3 bg-cream rounded-xl p-4">
                        <FormControl>
                          <Checkbox
                            checked={field.value}
                            onCheckedChange={field.onChange}
                            className="mt-0.5"
                          />
                        </FormControl>
                        <div>
                          <FormLabel className="text-sm font-medium text-dark cursor-pointer">
                            Soy huésped del hotel
                          </FormLabel>
                          <p className="text-xs text-dark/50 mt-0.5">
                            {isFree
                              ? 'Las clases gratuitas son exclusivas para huéspedes'
                              : 'Los huéspedes pueden acceder a tarifas especiales'}
                          </p>
                        </div>
                      </div>
                    </FormItem>
                  )} />

                  {watchGuest && (
                    <FormField control={form.control} name="cloudbedsRef" render={({ field }) => (
                      <FormItem>
                        <FormLabel>
                          Número de reserva Cloudbeds{' '}
                          <span className="text-dark/40 font-normal">(opcional)</span>
                        </FormLabel>
                        <FormControl>
                          <Input placeholder="Ej: CB-123456" {...field} />
                        </FormControl>
                        <FormMessage />
                      </FormItem>
                    )} />
                  )}

                  <div className="flex gap-3 pt-2">
                    <Button type="button" variant="outline" onClick={() => setStep(1)} className="flex-1 h-11">
                      <ArrowLeft className="w-4 h-4 mr-2" /> Atrás
                    </Button>
                    <Button type="submit" className="flex-1 bg-dark hover:bg-burgundy text-cream h-11">
                      Continuar <ArrowRight className="w-4 h-4 ml-2" />
                    </Button>
                  </div>
                </form>
              </Form>
            </motion.div>
          )}

          {/* ── PASO 3: Confirmar y pagar ── */}
          {step === 3 && personalData && (
            <motion.div key="step3" variants={stepVariants} initial="enter" animate="center" exit="exit" transition={{ duration: 0.25 }}>
              <h2 className="font-serif text-2xl font-light text-dark mb-1">Confirmar reserva</h2>
              <p className="text-sm text-dark/50 mb-6">Revisá los detalles antes de confirmar</p>

              <div className="space-y-3 mb-6">
                {/* Clase */}
                <div className="bg-cream rounded-2xl p-4">
                  <p className="text-[10px] uppercase tracking-widest text-dark/40 mb-2">Clase</p>
                  <p className="font-serif text-lg text-dark">{className}</p>
                  <p className="text-sm text-dark/60">
                    con {instructor} · {format(classDate, "d MMM, HH:mm", { locale: es })}
                  </p>
                  <p className="text-sm text-dark/50 mt-1">{location} · {persons} persona{persons > 1 ? 's' : ''}</p>
                </div>

                {/* Datos */}
                <div className="bg-cream rounded-2xl p-4">
                  <p className="text-[10px] uppercase tracking-widest text-dark/40 mb-2">Tus datos</p>
                  <p className="font-medium text-dark">{personalData.firstName} {personalData.lastName}</p>
                  <p className="text-sm text-dark/60">{personalData.email}</p>
                  {personalData.phone && <p className="text-sm text-dark/60">{personalData.phone}</p>}
                  {personalData.isHotelGuest && (
                    <p className="text-xs text-emerald-600 mt-1">✓ Huésped del hotel{personalData.cloudbedsRef ? ` · ${personalData.cloudbedsRef}` : ''}</p>
                  )}
                </div>

                {/* Desglose de precio */}
                <div className="bg-cream rounded-2xl p-4">
                  <p className="text-[10px] uppercase tracking-widest text-dark/40 mb-3">Resumen</p>
                  <div className="space-y-1.5">
                    <div className="flex justify-between text-sm text-dark/70">
                      <span>{className} × {persons}</span>
                      <span>{isFree ? 'Gratis' : `$${subtotalClass}`}</span>
                    </div>
                    {selectedUpsellsList.map(({ upsell, qty }) => (
                      <div key={upsell.id} className="flex justify-between text-sm text-dark/70">
                        <span>{upsell.name} × {qty}</span>
                        <span>${upsell.priceUsd * qty}</span>
                      </div>
                    ))}
                    <div className="flex justify-between font-semibold text-dark pt-2 border-t border-dark/10 text-base">
                      <span>Total</span>
                      <span className={isTotalFree ? 'text-emerald-600' : ''}>{isTotalFree ? 'Gratis' : `$${total} USD`}</span>
                    </div>
                  </div>
                </div>

                {/* Pago */}
                {isTotalFree ? (
                  <div className="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 flex items-center gap-3">
                    <Check className="w-5 h-5 text-emerald-600 flex-shrink-0" />
                    <div>
                      <p className="text-sm font-medium text-emerald-800">Reserva gratuita</p>
                      <p className="text-xs text-emerald-600 mt-0.5">No se requiere pago</p>
                    </div>
                  </div>
                ) : (
                  <div className="border border-dark/10 rounded-2xl p-4">
                    <p className="text-[10px] uppercase tracking-widest text-dark/40 mb-3">Pago seguro</p>
                    {/* STRIPE ELEMENTS: se integrará aquí con @stripe/stripe-js */}
                    <div className="bg-dark/3 border border-dark/10 rounded-xl p-4 flex items-center gap-3 text-dark/40">
                      <CreditCard className="w-5 h-5 flex-shrink-0" />
                      <span className="text-sm">Formulario de pago con Stripe (pendiente integración)</span>
                    </div>
                    <p className="text-xs text-dark/40 mt-2 text-center">
                      🔒 Pago procesado de forma segura por Stripe
                    </p>
                  </div>
                )}
              </div>

              <div className="flex gap-3">
                <Button type="button" variant="outline" onClick={() => setStep(2)} className="flex-1 h-11">
                  <ArrowLeft className="w-4 h-4 mr-2" /> Atrás
                </Button>
                <Button onClick={handleConfirm} className="flex-1 bg-dark hover:bg-burgundy text-cream h-11">
                  {isTotalFree ? 'Confirmar reserva' : `Pagar $${total} USD`}
                  {!isTotalFree && <CreditCard className="w-4 h-4 ml-2" />}
                </Button>
              </div>
            </motion.div>
          )}

          {/* ── PASO 4: Confirmación ── */}
          {step === 4 && (
            <motion.div
              key="step4"
              initial={{ opacity: 0, scale: 0.97 }}
              animate={{ opacity: 1, scale: 1 }}
              transition={{ duration: 0.4 }}
              className="text-center"
            >
              <motion.div
                initial={{ scale: 0 }}
                animate={{ scale: 1 }}
                transition={{ delay: 0.15, type: 'spring', stiffness: 200, damping: 14 }}
                className="w-20 h-20 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-5"
              >
                <Check className="w-10 h-10 text-emerald-600" />
              </motion.div>

              <h2 className="font-serif text-3xl font-light text-dark mb-1">¡Reserva confirmada!</h2>
              <p className="text-dark/50 text-sm mb-7">
                Te esperamos en el shala. Recibirás un email de confirmación.
              </p>

              {/* Card de confirmación */}
              <div className="bg-cream rounded-2xl p-5 mb-6 text-left">
                <div className="text-center pb-4 mb-4 border-b border-dark/10">
                  <p className="text-[10px] uppercase tracking-widest text-dark/40 mb-1">Código de reserva</p>
                  <p className="font-mono text-xl font-bold text-dark">{bookingRef}</p>
                </div>
                <div className="space-y-2">
                  <Row label="Clase" value={className} />
                  <Row label="Instructor" value={instructor} />
                  <Row label="Fecha" value={format(classDate, "d 'de' MMMM yyyy · HH:mm", { locale: es })} />
                  <Row label="Ubicación" value={location} />
                  <Row label="Personas" value={String(persons)} />
                  {selectedUpsellsList.length > 0 && (
                    <Row
                      label="Extras"
                      value={selectedUpsellsList.map(({ upsell, qty }) => `${upsell.name} ×${qty}`).join(', ')}
                    />
                  )}
                  {personalData && <Row label="Nombre" value={`${personalData.firstName} ${personalData.lastName}`} />}
                  <div className="flex justify-between pt-2 border-t border-dark/10 font-semibold text-sm">
                    <span className="text-dark">Total pagado</span>
                    <span className={isTotalFree ? 'text-emerald-600' : 'text-dark'}>
                      {isTotalFree ? 'Gratis' : `$${total} USD`}
                    </span>
                  </div>
                </div>
              </div>

              {/* Acciones */}
              <div className="space-y-3">
                <Button
                  onClick={handleDownloadICS}
                  variant="outline"
                  className="w-full h-11 gap-2"
                >
                  <Calendar className="w-4 h-4" />
                  Agregar al calendario (.ics)
                </Button>
                <div className="grid grid-cols-2 gap-3">
                  <Link href="/clases">
                    <Button variant="outline" className="w-full h-11">
                      Ver más clases
                    </Button>
                  </Link>
                  <Link href="/">
                    <Button className="w-full bg-dark hover:bg-burgundy text-cream h-11">
                      Inicio
                    </Button>
                  </Link>
                </div>
              </div>

              <p className="text-xs text-dark/40 mt-5">
                📧 Se envió una confirmación a {personalData?.email}
              </p>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    </div>
  );
}

function Row({ label, value }: { label: string; value: string }) {
  return (
    <div className="flex justify-between gap-4 text-sm py-1 border-b border-dark/5 last:border-0">
      <span className="text-dark/50">{label}</span>
      <span className="text-dark text-right">{value}</span>
    </div>
  );
}
